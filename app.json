{
  "expo": {
    "name": "e-comm-expo",
    "slug": "e-comm-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ecomm",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.ecommexpo",
      "buildNumber": "1.0.0",
      "config": {
        "googleMapsApiKey": "AIzaSyACYDuQEBFQZWFNj1U838PoHEARNzPPCBw"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs access to location to show nearby stores and delivery options.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app needs access to location to show nearby stores and delivery options."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.yourcompany.ecommexpo",
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            { "scheme": "ecomm" },
            { "scheme": "https", "host": "stores.yourdomain.com", "pathPrefix": "/store" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyACYDuQEBFQZWFNj1U838PoHEARNzPPCBw"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "92688e56-01bd-4ba6-99dd-e4bb4922ad33"
      }
    }
  }
}
