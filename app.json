{
  "expo": {
    "name": "e-comm-expo",
    "slug": "e-comm-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ecomm",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.ecommexpo",
      "buildNumber": "1.0.0",
      "config": {
        "googleMapsApiKey": "AIzaSyAVXxFLtJn-hLmeLAreKFdON1rzuHtNBDc"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs access to location to show nearby stores and delivery options.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app needs access to location to show nearby stores and delivery options.",
        "NSMicrophoneUsageDescription": "This app needs access to microphone for voice search functionality.",
        "NSSpeechRecognitionUsageDescription": "This app uses speech recognition to convert your voice to text for search.",
        "NSCameraUsageDescription": "This app needs access to camera to take photos of prescriptions.",
        "NSPhotoLibraryUsageDescription": "This app needs access to photo library to select prescription images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.yourcompany.ecommexpo",
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "ecomm",
              "host": "*"
            },
            {
              "scheme": "https",
              "host": "stores.yourdomain.com",
              "pathPrefix": "/store"
            },
            {
              "scheme": "https",
              "host": "ecomm-stores.com",
              "pathPrefix": "/store"
            },
            {
              "scheme": "https",
              "host": "qr.ecomm.com",
              "pathPrefix": "/s"
            },
            {
              "scheme": "https",
              "host": "marg-api.thelocalsandbox.dev",
              "pathPrefix": "/dl"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAVXxFLtJn-hLmeLAreKFdON1rzuHtNBDc"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "config": {
        "googleMapsApiKey": "AIzaSyAVXxFLtJn-hLmeLAreKFdON1rzuHtNBDc"
      }
    },
    "extra": {
      "eas": {
        "projectId": "92688e56-01bd-4ba6-99dd-e4bb4922ad33"
      },
      "googleMapsApiKey": "AIzaSyAVXxFLtJn-hLmeLAreKFdON1rzuHtNBDc"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "This app needs access to location to show nearby stores and delivery options."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them.",
          "cameraPermission": "The app accesses your camera to let you take photos of prescriptions."
        }
      ]
    ]
  }
}
